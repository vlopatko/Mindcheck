{
  "name": "mindcheck",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "lint": "eslint app components lib --ignore-pattern components/ui",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:local": "node scripts/postgres.mjs start",
    "db:stop": "node scripts/postgres.mjs stop",
    "steam:setup-bot": "node scripts/setup-steam-bot.mjs",
    "steam:setup-secret": "node scripts/setup-credential-secret.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cs2parser": "^2.5.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "globaloffensive": "^3.3.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "qrcode-terminal": "^0.12.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "steam-session": "^1.9.4",
    "steam-user": "^5.3.0",
    "tailwind-merge": "3.6.0",
    "unbzip2-stream": "^1.4.3",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
